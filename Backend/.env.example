# Backend runtime
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-frontend-domain.example.com

# Database and cache
MONGO_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# JWT and cookies
# Simplest Render setup: set JWT_SECRET.
# If JWT_SECRET is blank and you use separate access/refresh secrets, also set OTP_PEPPER.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_COOKIE_MS=900000
JWT_REFRESH_COOKIE_MS=1209600000
PASSWORD_SALT_ROUNDS=10

# OTP login
OTP_DELIVERY_MODE=email
OTP_TTL_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_PEPPER=
ALLOW_DEV_OTP_FALLBACK=false
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Zingereizer

# Admin fallback login
ADMIN_PASSWORD=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Razorpay payments
RAZORPAY_KEY_ID=replace-with-key-id
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_CHECKOUT_NAME=Cafe Management System

# Twilio food-ready SMS
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_FROM_NUMBER=+10000000000
TWILIO_MESSAGING_SERVICE_SID=

# Web Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
